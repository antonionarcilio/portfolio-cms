#!/bin/sh
# Git pre-commit hook wrapper.
# Installed via scripts/install-hooks.sh
set -e

PYTHON=""
for candidate in python3 python; do
    if command -v "$candidate" >/dev/null 2>&1; then
        PYTHON="$candidate"
        break
    fi
done

if [ -z "$PYTHON" ]; then
    echo "Error: Python 3 is required for content validation" >&2
    exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

"$PYTHON" "$SCRIPT_DIR/validate_content.py"

# Generate TypeScript types from schema definitions
"$PYTHON" "$SCRIPT_DIR/generate_types.py"

# Stage generated types file for inclusion in the commit
if [ -f "$REPO_ROOT/content-types.d.ts" ]; then
    git add "$REPO_ROOT/content-types.d.ts"
fi
